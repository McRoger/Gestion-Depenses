<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Left Column: Local Expenses -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/textProg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dépenses locales :"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/nomDepense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="Nom dépense"
                android:inputType="textCapSentences"
                android:lines="1" />

            <EditText
                android:id="@+id/cout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Coût (€)"
                android:inputType="numberSigned|numberDecimal"
                android:lines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/creerDepense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Créer" />

            <Button
                android:id="@+id/supprimerDepenses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Supprimer" />

            <ImageButton
                android:id="@+id/exportDepense"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Exporter vers Dropbox"
                android:src="@android:drawable/arrow_down_float" />

            <ImageButton
                android:id="@+id/refreshListPhone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Rafraîchir liste locale"
                app:srcCompat="@android:drawable/ic_popup_sync" />

            <ImageButton
                android:id="@+id/search_voice_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Saisie vocale"
                app:srcCompat="@drawable/ic_micro" />
        </LinearLayout>

        <ListView
            android:id="@+id/listViewPhone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:choiceMode="multipleChoice"
            android:divider="@color/colorAccent"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Right Column: Dropbox Expenses -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/textProgDrive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dépenses sur Dropbox :"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/supprimerDepensesDrive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Supprimer du Drive" />

            <ImageButton
                android:id="@+id/importDepense"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Importer depuis Dropbox"
                android:src="@android:drawable/arrow_up_float" />

            <ImageButton
                android:id="@+id/refreshListDrive"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Rafraîchir liste Dropbox"
                app:srcCompat="@android:drawable/ic_popup_sync" />
        </LinearLayout>

        <ListView
            android:id="@+id/listViewDrive"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:choiceMode="multipleChoice"
            android:divider="@android:color/holo_orange_dark"
            android:dividerHeight="1dp" />
    </LinearLayout>

</LinearLayout>
